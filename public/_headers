# Vite fingerprints everything under /assets, so those files can never change
# behind a given URL — cache them indefinitely.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The entry document must always be revalidated, or a deploy never reaches
# anyone holding a cached copy.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()
